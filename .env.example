# Local development only. Never commit a real password or connection string.
# Option 1: use DATABASE_URL for a cloud database during controlled testing.
DATABASE_URL=

# Option 2: use the locally installed PostgreSQL database named gayanara.
GAYANARA_DB_HOST=127.0.0.1
GAYANARA_DB_PORT=5432
GAYANARA_DB_NAME=gayanara
GAYANARA_DB_USER=postgres
GAYANARA_DB_PASSWORD=
GAYANARA_LAB_PORT=8765

# Comma-separated exact browser origins. Do not use '*'.
CORS_ALLOWED_ORIGINS=https://subhanaristiadi.github.io,http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8765,http://localhost:8765
# Set true only for local file:// development. Keep false on Render.
ALLOW_NULL_ORIGIN=true
